<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ masks splash icons into circles. The full SVG is shown by
         the React splash immediately after this brief plain-background handoff. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#144A31</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">#144A31</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
